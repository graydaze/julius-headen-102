---
interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;

const strokePrimary = dark ? '#D4AF37' : '#9E7B1C';
const strokeHighlight = dark ? '#F4D03F' : '#B8860B';
const leftLineClass = dark
  ? 'bg-gradient-to-r from-transparent via-[#D4AF37]/60 to-[#F4D03F]'
  : 'bg-gradient-to-r from-transparent via-[#9E7B1C]/50 to-[#D4AF37]';
const rightLineClass = dark
  ? 'bg-gradient-to-l from-transparent via-[#D4AF37]/60 to-[#F4D03F]'
  : 'bg-gradient-to-l from-transparent via-[#9E7B1C]/50 to-[#D4AF37]';
---

<div class="my-6 flex items-center justify-center gap-4" role="separator" aria-hidden="true">
  <span class={`h-px w-20 sm:w-32 ${leftLineClass}`}></span>
  <svg
    width="36"
    height="36"
    viewBox="0 0 64 64"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="shrink-0"
    aria-hidden="true"
  >
    <!-- Compasses hinge and legs -->
    <circle cx="32" cy="11" r="4" stroke={strokeHighlight} stroke-width="2.5" />
    <path
      d="M29.5 14.5L13 48M34.5 14.5L51 48"
      stroke={strokeHighlight}
      stroke-width="3"
      stroke-linecap="round"
    />
    <!-- Compasses arc -->
    <path
      d="M21 31C24.3 33.4 28.1 34.6 32 34.6C35.9 34.6 39.7 33.4 43 31"
      stroke={strokePrimary}
      stroke-width="2"
      stroke-linecap="round"
    />
    <!-- Builder's Square -->
    <path
      d="M14 38L32 56L50 38"
      stroke={strokePrimary}
      stroke-width="3.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <!-- Central G -->
    <text
      x="32"
      y="43"
      text-anchor="middle"
      font-family="Cinzel, Georgia, serif"
      font-weight="700"
      font-size="16"
      fill={strokeHighlight}
    >
      G
    </text>
  </svg>
  <span class={`h-px w-20 sm:w-32 ${rightLineClass}`}></span>
</div>
