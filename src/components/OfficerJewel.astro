---
export type JewelType =
  | 'square'
  | 'level'
  | 'plumb'
  | 'keys'
  | 'pens'
  | 'book'
  | 'sun'
  | 'moon'
  | 'cornucopia'
  | 'batons'
  | 'sword';

interface Props {
  jewel: JewelType;
  size?: number;
  class?: string;
}

const { jewel, size = 32, class: className = '' } = Astro.props;
---

{
  jewel === 'square' && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class={className}
      aria-hidden="true"
    >
      {/* Worshipful Master: Builder's Square */}
      <polygon
        points="24,41 6,23 11,18 24,31 37,18 42,23"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linejoin="round"
      />
      <path
        d="M12.5 24.5L14.5 22.5M16.5 28.5L18.5 26.5M35.5 24.5L33.5 22.5M31.5 28.5L29.5 26.5"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      />
      <circle cx="24" cy="36" r="1.4" fill="currentColor" />
    </svg>
  )
}

{
  jewel === 'level' && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class={className}
      aria-hidden="true"
    >
      {/* Senior Warden: Mason's Level */}
      <path
        d="M7 37H41"
        stroke="currentColor"
        stroke-width="2.8"
        stroke-linecap="round"
      />
      <path
        d="M24 10L10 37M24 10L38 37"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M16 26H32"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
      <path
        d="M24 13V30"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      />
      <circle cx="24" cy="32" r="2.5" fill="currentColor" />
    </svg>
  )
}

{
  jewel === 'plumb' && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class={className}
      aria-hidden="true"
    >
      {/* Junior Warden: Plumb Rule */}
      <path
        d="M12 10H36"
        stroke="currentColor"
        stroke-width="2.6"
        stroke-linecap="round"
      />
      <path
        d="M16 10V38H32V10"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linejoin="round"
      />
      <path
        d="M24 10V26"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      />
      <polygon
        points="24,25 27.5,30.5 24,35 20.5,30.5"
        stroke="currentColor"
        stroke-width="2"
        fill="currentColor"
        fill-opacity="0.25"
        stroke-linejoin="round"
      />
    </svg>
  )
}

{
  jewel === 'keys' && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class={className}
      aria-hidden="true"
    >
      {/* Treasurer: Crossed Keys */}
      <circle cx="14" cy="14" r="5" stroke="currentColor" stroke-width="2.3" />
      <path
        d="M17.8 17.8L35 35M31 31L27.5 34.5M34.5 34.5L31 38"
        stroke="currentColor"
        stroke-width="2.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <circle cx="34" cy="14" r="5" stroke="currentColor" stroke-width="2.3" />
      <path
        d="M30.2 17.8L13 35M17 31L20.5 34.5M13.5 34.5L17 38"
        stroke="currentColor"
        stroke-width="2.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}

{
  jewel === 'pens' && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class={className}
      aria-hidden="true"
    >
      {/* Secretary: Crossed Quill Pens */}
      <path
