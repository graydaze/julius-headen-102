        stroke="currentColor"
        stroke-width="2.3"
        stroke-linejoin="round"
      />
      <path
        d="M24 14V36"
        stroke="currentColor"
        stroke-width="2.1"
        stroke-linecap="round"
      />
      <path
        d="M12.5 19.5H19.5M12.5 24.5H19.5M28.5 19.5H35.5M28.5 24.5H35.5"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
      />
    </svg>
  )
}

{
  jewel === 'sun' && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
