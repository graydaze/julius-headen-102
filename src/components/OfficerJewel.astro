      class={className}
      aria-hidden="true"
    >
      {/* Senior & Junior Stewards: Cornucopia */}
      <path
        d="M10 36C12 24 19 16 30 13C34.5 11.8 38 14.8 36.8 19.2C33.5 28.5 23.5 34.5 11.5 37.2C10.5 37.4 9.8 36.8 10 36Z"
        stroke="currentColor"
        stroke-width="2.3"
        fill="currentColor"
        fill-opacity="0.15"
        stroke-linejoin="round"
      />
      <path
        d="M27.5 14C30 17.5 32.5 21 35 23.5M20.5 20.5C23 23.5 25.5 26 28 28M15 27.5C17 29.5 19 31.5 21 33"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      />
      <circle cx="36.5" cy="11.5" r="2.2" fill="currentColor" />
      <circle cx="40" cy="16.5" r="1.8" fill="currentColor" />
      <circle cx="32.5" cy="9.5" r="1.6" fill="currentColor" />
    </svg>
  )
}

{
  jewel === 'batons' && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class={className}
      aria-hidden="true"
    >
      {/* Marshal: Crossed Batons */}
      <path
        d="M12 36L36 12"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
      />
      <path
        d="M12 12L36 36"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
      />
      <circle cx="11" cy="37" r="2.5" stroke="currentColor" stroke-width="2" />
      <circle cx="37" cy="11" r="2.5" stroke="currentColor" stroke-width="2" />
      <circle cx="11" cy="11" r="2.5" stroke="currentColor" stroke-width="2" />
      <circle cx="37" cy="37" r="2.5" stroke="currentColor" stroke-width="2" />
      <circle
        cx="24"
        cy="24"
        r="3.2"
        fill="currentColor"
        fill-opacity="0.25"
        stroke="currentColor"
        stroke-width="1.8"
      />
    </svg>
