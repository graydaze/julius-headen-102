}

{
  jewel === 'sword' && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class={className}
      aria-hidden="true"
    >
      {/* Tiler: Drawn Sword */}
      <polygon
        points="24,6 27,13 26.2,31 21.8,31 21,13"
        stroke="currentColor"
        stroke-width="2.2"
        fill="currentColor"
        fill-opacity="0.16"
        stroke-linejoin="round"
      />
      <path
        d="M24 12V30"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      />
      <path
        d="M13 31.5H35"
