---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Julius A. Headen Lodge No. 102" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Inter:wght@400;600&display=swap" rel="stylesheet">
		<title>{title} | Julius A. Headen Lodge No. 102</title>
		<script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
	</head>
	<body class="bg-gray-50 flex flex-col min-h-screen font-sans text-gray-900">
		
		<header class="bg-[#0A192F] text-white shadow-md border-b-4 border-[#D4AF37]">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center h-20">
					<div class="flex-shrink-0 flex items-center">
						<a href="/" class="text-2xl font-bold tracking-wider text-[#D4AF37]">
							Lodge No. 102
						</a>
					</div>
					<nav class="hidden md:flex space-x-8">
						<a href="/" class="hover:text-[#D4AF37] transition-colors duration-200">Home</a>
						<a href="/history" class="hover:text-[#D4AF37] transition-colors duration-200">History</a>
						<a href="/leadership" class="hover:text-[#D4AF37] transition-colors duration-200">Leadership</a>
						<a href="/events" class="hover:text-[#D4AF37] transition-colors duration-200">Events</a>
						<a href="/dues" class="hover:text-[#D4AF37] transition-colors duration-200">Dues</a>
					</nav>
					<div class="md:hidden flex items-center">
						<button class="text-white hover:text-[#D4AF37] focus:outline-none">
							<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
							</svg>
						</button>
					</div>
				</div>
			</div>
		</header>

		<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
			<slot />
		</main>

		<footer class="bg-[#333333] text-gray-300 py-8 border-t-4 border-[#D4AF37]">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center">
				<div class="mb-4 md:mb-0">
					<p class="text-sm">&copy; {new Date().getFullYear()} Julius A. Headen Lodge No. 102. All rights reserved.</p>
				</div>
				<div class="flex space-x-6 text-sm">
					<a href="/contact" class="hover:text-white transition-colors duration-200">Contact Us</a>
					<a href="/admin" class="hover:text-white transition-colors duration-200">Officer Login</a>
				</div>
			</div>
		</footer>

		<script is:inline>
		  if (window.netlifyIdentity) {
		    window.netlifyIdentity.on("init", user => {
		      if (!user) {
		        window.netlifyIdentity.on("login", () => {
		          document.location.href = "/admin/";
		        });
		      }
		    });
		  }
		</script>
	</body>
</html>
