---
import Layout from '../layouts/Layout.astro';
import MasonicDivider from '../components/MasonicDivider.astro';
import OfficerCard, { type Officer } from '../components/OfficerCard.astro';
import officersData from '../data/officers.json';

const masonicYear = officersData.masonicYear;
const lodgeName = officersData.lodgeName;
const electedOfficers = officersData.elected as Officer[];
const appointedOfficers = officersData.appointed as Officer[];

const featuredElected = electedOfficers.filter((officer) => officer.featured);
const standardElected = electedOfficers.filter((officer) => !officer.featured);
const hasAppointed = appointedOfficers.length > 0;
---

<Layout
  title="Lodge Officers"
  description={`Meet the ${hasAppointed ? 'elected and appointed ' : 'elected '}Lodge Officers serving ${lodgeName} for the ${masonicYear} Masonic year in Federal Way, Washington.`}
>
  <!-- Page Banner -->
  <section class="relative mosaic-pavement text-white py-16 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-[#D4AF37]">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_20%,rgba(212,175,55,0.16),transparent_60%)]"
      aria-hidden="true"
    ></div>
    <div class="relative max-w-4xl mx-auto text-center">
      <p class="text-xs uppercase tracking-[0.28em] text-[#D4AF37] font-semibold mb-3">
        Masonic Year {masonicYear}
      </p>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-wide text-gold-gradient">
        Lodge Officers
      </h1>
      <MasonicDivider dark={true} />
      <p class="text-gray-200/90 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        The {hasAppointed ? 'elected and appointed' : 'elected'} brethren entrusted with governing, instructing, and serving {lodgeName} during the {masonicYear} Masonic year.
      </p>
    </div>
  </section>

  <!-- Elected Officers Section -->
  <section class="max-w-7xl mx-auto py-16 sm:py-20 px-4 sm:px-6 lg:px-8">
    <div class="reveal text-center max-w-3xl mx-auto mb-12">
      <p class="text-xs uppercase tracking-[0.28em] text-[#9E7B1C] font-semibold mb-3">
        Elected Line
      </p>
      <h2 class="text-3xl sm:text-4xl font-bold text-[#0A192F] tracking-wide">
        Elected Officers
      </h2>
      <MasonicDivider dark={false} />
    </div>

    {/* Featured Spotlight: Worshipful Master */}
    {
      featuredElected.length > 0 && (
        <div class="max-w-xl mx-auto mb-10 space-y-6">
          {featuredElected.map((officer) => (
            <OfficerCard officer={officer} />
          ))}
        </div>
      )
    }

    {/* Remaining Elected Officers in Precedence Order */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-7">
      {
        standardElected.map((officer, index) => (
          <OfficerCard officer={officer} delayMs={index * 80} />
        ))
      }
    </div>

    {
      !hasAppointed && (
        <div class="reveal mt-14 max-w-4xl mx-auto bg-white rounded-sm p-6 sm:p-8 border border-[#D4AF37]/30 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-bold text-[#0A192F] tracking-wide">
              Need to Reach the Lodge?
            </h3>
            <p class="mt-1 text-sm text-gray-600">
              For official correspondence, visiting Brother verification, or membership inquiries, please contact the Lodge Secretary.
            </p>
          </div>
          <a
            href="/contact"
            class="shrink-0 inline-flex items-center justify-center px-6 py-2.5 border border-[#0A192F] text-[#0A192F] text-xs uppercase tracking-[0.16em] font-semibold rounded-sm hover:bg-[#0A192F] hover:text-[#F4D03F] transition-colors"
          >
            Contact the Lodge
          </a>
        </div>
      )
    }
  </section>

  <!-- Appointed Officers Section (renders automatically when entries exist in officers.json) -->
  {
    hasAppointed && (
      <section class="border-t border-[#D4AF37]/30 bg-gradient-to-b from-[#F2EEE4] to-[#F8F6F0] py-16 sm:py-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto">
          <div class="reveal text-center max-w-3xl mx-auto mb-12">
            <p class="text-xs uppercase tracking-[0.28em] text-[#9E7B1C] font-semibold mb-3">
              Appointed Line
            </p>
            <h2 class="text-3xl sm:text-4xl font-bold text-[#0A192F] tracking-wide">
              Appointed Officers
            </h2>
            <MasonicDivider dark={false} />
          </div>

          {/* Centered Responsive Flex Grid */}
          <div class="flex flex-wrap justify-center gap-6 lg:gap-7">
            {
              appointedOfficers.map((officer, index) => (
                <div class="w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1.2rem)]">
                  <OfficerCard officer={officer} delayMs={(index % 3) * 80} />
                </div>
              ))
            }
          </div>

          <!-- Direct Lodge Contact Callout -->
          <div class="reveal mt-14 max-w-4xl mx-auto bg-white rounded-sm p-6 sm:p-8 border border-[#D4AF37]/30 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-[#0A192F] tracking-wide">
                Need to Reach the Lodge?
              </h3>
              <p class="mt-1 text-sm text-gray-600">
                For official correspondence, visiting Brother verification, or membership inquiries, please contact the Lodge Secretary.
              </p>
            </div>
            <a
              href="/contact"
              class="shrink-0 inline-flex items-center justify-center px-6 py-2.5 border border-[#0A192F] text-[#0A192F] text-xs uppercase tracking-[0.16em] font-semibold rounded-sm hover:bg-[#0A192F] hover:text-[#F4D03F] transition-colors"
            >
              Contact the Lodge
            </a>
          </div>
        </div>
      </section>
    )
  }
</Layout>
