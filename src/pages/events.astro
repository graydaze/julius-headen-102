---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Events">
	<div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
		<h1 class="font-serif text-4xl font-bold text-[#0A192F] mb-6 border-b-4 border-[#D4AF37] inline-block pb-2">
			Upcoming Events
		</h1>
		<p class="text-lg text-gray-700 mb-8">
			Join us for our upcoming stated communications, degree work, and community fellowship events.
		</p>
		
		<div class="space-y-6">
			<div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-[#D4AF37]">
				<h2 class="font-serif text-2xl font-bold text-[#0A192F] mb-3">Stated Communication</h2>
				
				<div class="flex items-center text-gray-600 mb-2 font-semibold">
					<Icon name="tabler:calendar-event" class="w-5 h-5 mr-2 text-[#D4AF37]" />
					<span>First Tuesday of the Month | 7:00 PM</span>
				</div>

				<div class="flex items-center text-gray-600 mb-4 font-semibold">
					<Icon name="tabler:map-pin" class="w-5 h-5 mr-2 text-[#D4AF37]" />
					<span>Lodge Building, Main Hall</span>
				</div>

				<p class="text-gray-700">Regular business meeting. Visiting brethren are welcome with proper identification.</p>
				
				<div class="mt-4 pt-4 border-t border-gray-100">
					<p class="text-sm italic text-gray-400">
						[CMS Note: When the Secretary adds an event in the dashboard, it will automatically generate a card like this.]
					</p>
				</div>
			</div>
		</div>
	</div>
</Layout>