---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Leadership">
	<div class="max-w-6xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
		<h1 class="font-serif text-4xl font-bold text-[#0A192F] mb-6 border-b-4 border-[#D4AF37] inline-block pb-2">
			Lodge Leadership
		</h1>
		<p class="text-lg text-gray-700 mb-8">
			Meet the officers guiding Julius A. Headen Lodge No. 102 for the current Masonic year.
		</p>
		
		<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mt-8">
			<div class="bg-white rounded-lg shadow-md overflow-hidden border-t-4 border-[#0A192F] flex flex-col items-center p-6 text-center">
				<div class="w-32 h-32 bg-gray-200 rounded-full mb-4 flex items-center justify-center text-gray-400 shadow-inner">
					<span>No Photo</span>
				</div>
				<h2 class="font-serif text-xl font-bold text-[#0A192F]">Worshipful Master</h2>
				<p class="text-[#D4AF37] font-semibold mt-1">Name Placeholder</p>
				<p class="text-sm italic text-gray-400 mt-4">
					[CMS Note: Officer profiles and photos will populate here.]
				</p>
			</div>
		</div>
	</div>
</Layout>
