---
import Layout from '../layouts/Layout.astro';
import MasonicDivider from '../components/MasonicDivider.astro';

const milestones = [
  {
    date: '1993',
    title: 'Grand Lodge Initiative',
    description:
      'The Grand Lodge of Washington establishes the objective to form a Prince Hall Lodge in Federal Way.',
    variant: 'navy' as const,
  },
  {
    date: 'March 1994',
    title: 'Study Club Formed',
    description:
      'The Julius A. Headen study club begins meeting at the old hall of Thornton F. McElroy Lodge. The MWGM issues a dispensation to operate under the MWPHGL of WA.',
    variant: 'white' as const,
  },
  {
    date: 'July 1995',
    title: 'Charter Issued',
    description:
      'During the Annual Communication, Julius A. Headen U.D. is officially presented with Charter No. 102.',
    variant: 'navy' as const,
  },
  {
    date: 'September 1995',
    title: 'Lodge Consecration',
    description:
      'Grand Lodge Officers consecrate Julius A. Headen Lodge No. 102 to operate under the jurisdiction of the MWPHGL of WA, upholding the principles of Friendship, Morality, and Brotherly Love.',
    variant: 'white' as const,
  },
];
---

<Layout
  title="Our History"
  description="Explore the legacy of Julius A. Headen and the founding history of Julius A. Headen Lodge No. 102 in Federal Way, Washington."
>
  <!-- Page Banner -->
  <section class="relative mosaic-pavement text-white py-16 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-[#D4AF37]">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_20%,rgba(212,175,55,0.16),transparent_60%)]"
      aria-hidden="true"
    ></div>
    <div class="relative max-w-4xl mx-auto text-center">
      <p class="text-xs uppercase tracking-[0.28em] text-[#D4AF37] font-semibold mb-3">
        Lodge Heritage &amp; Archives
      </p>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-wide text-gold-gradient">
        Our History
      </h1>
      <MasonicDivider dark={true} />
      <p class="text-gray-200/90 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        The rich history of Julius A. Headen Lodge No. 102 is built upon a foundation of brotherhood, relief, and truth.
      </p>
    </div>
  </section>

  <!-- The Legacy of Julius A. Headen: Editorial Biography -->
  <section class="max-w-6xl mx-auto py-16 sm:py-20 px-4 sm:px-6 lg:px-8" id="lodge-history">
    <div class="reveal text-center max-w-3xl mx-auto mb-12">
      <p class="text-xs uppercase tracking-[0.28em] text-[#9E7B1C] font-semibold mb-3">
        Our Namesake
      </p>
      <h2 class="text-3xl sm:text-4xl font-bold text-[#0A192F] tracking-wide">
        The Legacy of Julius A. Headen
      </h2>
      <MasonicDivider dark={false} />
    </div>

    <!-- Narrative Editorial Card with Tesselated Double-Line Border & Classical Gold Drop Cap -->
    <article class="reveal relative max-w-4xl mx-auto bg-white rounded-sm p-8 sm:p-12 border border-[#D4AF37]/45 shadow-md">
      <div
        class="pointer-events-none absolute inset-2.5 border border-[#D4AF37]/25 rounded-xs"
        aria-hidden="true"
      ></div>
      <div class="relative z-10 space-y-6 text-[#0A192F]/90 text-base sm:text-lg leading-relaxed">
        <p class="first-letter:float-left first-letter:font-display first-letter:text-5xl sm:first-letter:text-6xl first-letter:font-bold first-letter:leading-[0.85] first-letter:pr-3 first-letter:pt-1 first-letter:text-[#9E7B1C]">
          Julius A. Headen was a native of North Carolina, a United States Army veteran, and a skilled builder who made his home in Washington state with his wife, Antonia Headen. Remembered as a pillar of the Tacoma community, he was a dedicated mentor who guided young men during a time when Masonry was experiencing a generational shift.
        </p>
        <p>
          Headen emphasized leadership rooted in integrity, fairness, and the foundational principles of the order: the Holy Bible, the square, and the compass. He consistently prioritized the success of the lodge, sacrificing personal time and resources to ensure its prosperity.
        </p>
      </div>
    </article>

    <!-- Core Attributes Grid -->
    <div class="max-w-5xl mx-auto mt-14">
      <div class="reveal text-center mb-10">
        <p class="text-xs uppercase tracking-[0.26em] text-[#9E7B1C] font-semibold mb-2">
          Character &amp; Example
        </p>
        <h3 class="text-2xl sm:text-3xl font-bold text-[#0A192F] tracking-wide">
          Core Attributes
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Mentorship -->
        <article class="reveal group bg-white rounded-sm p-8 border border-[#D4AF37]/30 border-t-4 border-t-[#D4AF37] shadow-sm hover:shadow-xl hover:border-[#D4AF37] hover:-translate-y-1 transition-all duration-300 flex flex-col items-center text-center">
          <div class="w-14 h-14 rounded-full bg-[#0A192F] border border-[#D4AF37]/60 text-[#F4D03F] flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          </div>
          <h4 class="font-display text-xl font-bold text-[#0A192F] tracking-wide mb-3">
            Mentorship
          </h4>
          <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
            Bridged the generation gap by setting high ideals and a lasting precedent for young men to follow.
          </p>
        </article>

        <!-- Community Leader -->
        <article
          class="reveal group bg-white rounded-sm p-8 border border-[#D4AF37]/30 border-t-4 border-t-[#D4AF37] shadow-sm hover:shadow-xl hover:border-[#D4AF37] hover:-translate-y-1 transition-all duration-300 flex flex-col items-center text-center"
          style="transition-delay: 100ms;"
        >
          <div class="w-14 h-14 rounded-full bg-[#0A192F] border border-[#D4AF37]/60 text-[#F4D03F] flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 21h18" />
              <path d="M5 21V7l7-4 7 4v14" />
              <path d="M9 21v-6h6v6" />
              <path d="M9 10h.01" />
              <path d="M15 10h.01" />
            </svg>
          </div>
          <h4 class="font-display text-xl font-bold text-[#0A192F] tracking-wide mb-3">
            Community Leader
          </h4>
          <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
            Recognized across Tacoma as a skilled physical mason, kind guide, and respected civic presence.
          </p>
        </article>

        <!-- Dedication -->
        <article
          class="reveal group bg-white rounded-sm p-8 border border-[#D4AF37]/30 border-t-4 border-t-[#D4AF37] shadow-sm hover:shadow-xl hover:border-[#D4AF37] hover:-translate-y-1 transition-all duration-300 flex flex-col items-center text-center"
          style="transition-delay: 200ms;"
        >
          <div class="w-14 h-14 rounded-full bg-[#0A192F] border border-[#D4AF37]/60 text-[#F4D03F] flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          </div>
          <h4 class="font-display text-xl font-bold text-[#0A192F] tracking-wide mb-3">
            Dedication
          </h4>
          <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
            Routinely sacrificed personal time and finances to uphold and advance the Masonic order.
          </p>
        </article>
      </div>
    </div>

    <!-- Masonic Leadership Editorial Card -->
    <article class="reveal relative max-w-4xl mx-auto mt-16 bg-[#0A192F] text-white rounded-sm p-8 sm:p-12 border border-[#D4AF37]/45 border-t-4 border-t-[#D4AF37] shadow-2xl">
      <div
        class="pointer-events-none absolute inset-2.5 border border-[#D4AF37]/20 rounded-xs"
        aria-hidden="true"
      ></div>
      <div class="relative z-10">
        <div class="text-center mb-8">
          <p class="text-xs uppercase tracking-[0.26em] text-[#D4AF37] font-semibold mb-2">
            Service to the Craft
          </p>
          <h2 class="text-2xl sm:text-3xl font-bold text-gold-gradient tracking-wide">
            Masonic Leadership
          </h2>
          <MasonicDivider dark={true} />
        </div>

        <p class="text-gray-200 text-base sm:text-lg leading-relaxed">
          Before the formation of his namesake lodge, Brother Headen was a fiercely dedicated member of <strong class="text-[#F4D03F] font-semibold">Cassia Lodge No. 5</strong> in Tacoma, Washington. His professionalism and work ethic earned him the following leadership roles:
        </p>

        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="bg-[#06101F]/80 border border-[#D4AF37]/35 rounded-sm p-6 hover:border-[#F4D03F] transition-colors">
            <div class="flex items-center gap-3 mb-2">
              <span class="w-9 h-9 rounded-full bg-[#0A192F] border border-[#D4AF37]/60 text-[#F4D03F] flex items-center justify-center shrink-0">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m2 4 3 12h14l3-12-6 7-4-7-4 7-6-7Z" />
                  <path d="M5 20h14" />
                </svg>
              </span>
              <h3 class="text-lg font-bold text-[#F4D03F] tracking-wide">
                Worshipful Master
              </h3>
            </div>
            <p class="text-sm sm:text-base text-gray-300 leading-relaxed">
              Elected to lead Cassia No. 5 in 1974.
            </p>
          </div>

          <div class="bg-[#06101F]/80 border border-[#D4AF37]/35 rounded-sm p-6 hover:border-[#F4D03F] transition-colors">
            <div class="flex items-center gap-3 mb-2">
              <span class="w-9 h-9 rounded-full bg-[#0A192F] border border-[#D4AF37]/60 text-[#F4D03F] flex items-center justify-center shrink-0">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="8" r="6" />
                  <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
                </svg>
              </span>
              <h3 class="text-lg font-bold text-[#F4D03F] tracking-wide">
                Grand Lodge Trustee
              </h3>
            </div>
            <p class="text-sm sm:text-base text-gray-300 leading-relaxed">
              Served the jurisdiction for 13 consecutive years.
            </p>
          </div>
        </div>

        <blockquote class="mt-8 bg-[#06101F]/70 border-l-4 border-[#D4AF37] rounded-r-sm px-6 py-4 text-gray-300 italic text-sm sm:text-base leading-relaxed">
          In February 1993, Brother Headen passed away and was laid to rest at the New Tacoma Cemetery in Tacoma, Washington.
        </blockquote>
      </div>
    </article>
  </section>

  <!-- Chronological Timeline: The Founding of Lodge No. 102 -->
  <section class="relative border-t border-[#D4AF37]/30 bg-gradient-to-b from-[#F2EEE4] to-[#F8F6F0] py-16 sm:py-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="reveal text-center max-w-3xl mx-auto mb-16">
        <p class="text-xs uppercase tracking-[0.28em] text-[#9E7B1C] font-semibold mb-3">
          Chronological Milestones
        </p>
        <h2 class="text-3xl sm:text-4xl font-bold text-[#0A192F] tracking-wide">
          The Founding of Lodge No. 102
        </h2>
        <MasonicDivider dark={false} />
      </div>

      <div class="relative">
        <!-- Vertical Gold Timeline Rail -->
        <div
          class="pointer-events-none absolute top-2 bottom-2 left-5 md:left-1/2 md:-translate-x-1/2 w-0.5 bg-gradient-to-b from-[#D4AF37]/30 via-[#D4AF37] to-[#D4AF37]/30"
          aria-hidden="true"
        ></div>

        <ol class="space-y-10 md:space-y-14">
          {
            milestones.map((milestone, index) => {
              const isLeft = index % 2 === 0;
              const isNavy = milestone.variant === 'navy';
              return (
                <li
                  class="reveal relative md:grid md:grid-cols-2 md:gap-12 items-center"
                  style={`transition-delay: ${index * 100}ms;`}
                >
                  {/* Glowing Gold Node Marker */}
                  <div
                    class="absolute left-5 md:left-1/2 top-7 md:top-1/2 -translate-x-1/2 md:-translate-y-1/2 z-10 flex items-center justify-center w-6 h-6 rounded-full bg-[#06101F] border-2 border-[#F4D03F] shadow-[0_0_16px_rgba(212,175,55,0.65)]"
                    aria-hidden="true"
                  >
                    <span class="w-2 h-2 rounded-full bg-[#F4D03F]" />
                  </div>

                  {/* Opposite-side Desktop Date Marker for Alternating Balance */}
                  <div
                    class:list={[
                      'hidden md:flex items-center gap-3',
                      isLeft
                        ? 'md:col-start-2 md:row-start-1 md:pl-4 justify-start'
                        : 'md:col-start-1 md:row-start-1 md:pr-4 justify-end',
                    ]}
                    aria-hidden="true"
                  >
                    {isLeft && <span class="h-px w-8 bg-[#D4AF37]/60" />}
                    <span class="font-display text-lg font-bold tracking-wider text-[#9E7B1C]">
                      {milestone.date}
                    </span>
                    {!isLeft && <span class="h-px w-8 bg-[#D4AF37]/60" />}
                  </div>

                  {/* Archival Milestone Card */}
                  <div
                    class:list={[
                      'pl-14 md:pl-0',
                      isLeft
                        ? 'md:col-start-1 md:row-start-1 md:pr-4'
                        : 'md:col-start-2 md:row-start-1 md:pl-4',
                    ]}
                  >
                    <article
                      class:list={[
                        'rounded-sm p-6 sm:p-8 border-t-4 border-t-[#D4AF37] shadow-md hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300',
                        isNavy
                          ? 'bg-[#0A192F] text-white border border-[#D4AF37]/40 hover:border-[#F4D03F]'
                          : 'bg-white text-[#0A192F] border border-[#D4AF37]/35 hover:border-[#D4AF37]',
                      ]}
                    >
                      <div class="flex items-center gap-2 mb-3">
                        <svg
                          width="15"
                          height="15"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class={isNavy ? 'text-[#F4D03F] shrink-0' : 'text-[#9E7B1C] shrink-0'}
                          aria-hidden="true"
                        >
                          <rect x="3" y="4" width="18" height="18" rx="2" />
                          <line x1="16" y1="2" x2="16" y2="6" />
                          <line x1="8" y1="2" x2="8" y2="6" />
                          <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                        <span
                          class:list={[
                            'inline-block px-2.5 py-0.5 rounded-xs text-xs uppercase tracking-[0.18em] font-semibold',
                            isNavy
                              ? 'bg-[#06101F] text-[#F4D03F] border border-[#D4AF37]/40'
                              : 'bg-[#F8F6F0] text-[#9E7B1C] border border-[#D4AF37]/40',
                          ]}
                        >
                          {milestone.date}
                        </span>
                      </div>

                      <h3
                        class:list={[
                          'text-xl sm:text-2xl font-bold tracking-wide',
                          isNavy ? 'text-white' : 'text-[#0A192F]',
                        ]}
                      >
                        {milestone.title}
                      </h3>

                      <p
                        class:list={[
                          'mt-3 text-sm sm:text-base leading-relaxed',
                          isNavy ? 'text-gray-200/90' : 'text-gray-600',
                        ]}
                      >
                        {milestone.description}
                      </p>
                    </article>
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>
    </div>
  </section>
</Layout>
